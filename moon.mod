name = "moonbitstack/moonrand"

version = "0.1.3"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonrand"

license = "Apache-2.0"

keywords = [
  "random",
  "rng",
  "prng",
  "pseudo-random",
  "chacha",
  "xoshiro",
  "xorshift",
  "pcg",
  "mersenne-twister",
  "mt19937",
  "philox",
  "threefry",
  "splitmix",
  "sfc",
  "jsf",
  "lcg",
  "lfsr",
  "lxm",
  "mrg",
  "well",
  "squares",
  "distributions",
  "sampling",
  "weighted-sampling",
  "bernoulli",
  "dirichlet",
  "chi-squared",
  "student-t",
  "cauchy",
  "laplace",
  "logistic",
  "gumbel",
  "rayleigh",
  "geometric",
  "monte-carlo",
  "simulation",
  "normal-distribution",
  "shuffle",
  "reproducible",
  "seed",
  "moonbit",
]

description = "Reproducible pseudo-random generators, unbiased sampling and the common distributions for MoonBit."

source = "src"

import {
  "moonbitstack/moonseed@0.1.3",
}
